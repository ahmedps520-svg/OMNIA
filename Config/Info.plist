<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys not expressible as INFOPLIST_KEY_* build settings. Xcode merges this file
	     with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). -->

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSMicrophoneUsageDescription</key>
	<string>OMNIA turns what you say into text for your message. Speech is recognized on this device and the audio is never stored or sent anywhere.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OMNIA recognizes your dictation on this device. Nothing you say leaves it.</string>

	<!-- Model downloads show on the Lock Screen and in the Dynamic Island (OMNIAWidgets). -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- Reading a reply aloud goes on with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- Exposes OMNIA's Documents folder in the Files app (On My iPad › OMNIA) so GGUF
	     models can be dropped in from a Mac or another app and imported. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GGUF Language Model</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.ggml.gguf</string>
			</array>
		</dict>
	</array>

	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.ggml.gguf</string>
			<key>UTTypeDescription</key>
			<string>GGUF Language Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gguf</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
