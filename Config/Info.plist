<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- Keys not expressible as INFOPLIST_KEY_* build settings. Xcode merges this file
	     with the generated Info.plist (GENERATE_INFOPLIST_FILE = YES). -->

	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>

	<key>NSMicrophoneUsageDescription</key>
	<string>OMNIA turns what you say into text for your message. Speech is recognized on this device and the audio is never stored or sent anywhere.</string>
	<key>NSSpeechRecognitionUsageDescription</key>
	<string>OMNIA recognizes your dictation on this device. Nothing you say leaves it.</string>

	<!-- Cluster mode: your devices run one model together over the local network. The host
	     advertises itself over Bonjour and serves join requests over plain HTTP on the LAN;
	     workers relay llama.cpp's RPC protocol. Nothing leaves the network. -->
	<key>NSLocalNetworkUsageDescription</key>
	<string>OMNIA connects to your own iPhones, iPads and PCs on this network so they can run a model together in a cluster. Nothing leaves your network.</string>
	<key>NSBonjourServices</key>
	<array>
		<string>_omnia-cluster._tcp</string>
	</array>
	<key>NSCameraUsageDescription</key>
	<string>OMNIA scans a cluster's QR code so this device can join it. The camera image isn't stored.</string>
	<key>NSAppTransportSecurity</key>
	<dict>
		<key>NSAllowsLocalNetworking</key>
		<true/>
	</dict>
	<!-- omnia://cluster?… links, which a host's QR code carries, open OMNIA to join it. -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key>
			<string>$(PRODUCT_BUNDLE_IDENTIFIER).cluster</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>omnia</string>
			</array>
		</dict>
	</array>

	<!-- Model downloads show on the Lock Screen and in the Dynamic Island (OMNIAWidgets). -->
	<key>NSSupportsLiveActivities</key>
	<true/>

	<!-- Replies that keep generating in the background on iPad (BackgroundAnswer): each one
	     submits "<bundle ID>.generation.<its own suffix>". -->
	<key>BGTaskSchedulerPermittedIdentifiers</key>
	<array>
		<string>$(PRODUCT_BUNDLE_IDENTIFIER).generation.*</string>
	</array>

	<!-- Reading a reply aloud goes on with the screen locked. -->
	<key>UIBackgroundModes</key>
	<array>
		<string>audio</string>
	</array>

	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<key>UIRequiredDeviceCapabilities</key>
	<array>
		<string>arm64</string>
		<string>metal</string>
	</array>

	<!-- Exposes OMNIA's Documents folder in the Files app (On My iPad › OMNIA) so GGUF
	     models can be dropped in from a Mac or another app and imported. -->
	<key>UIFileSharingEnabled</key>
	<true/>
	<key>LSSupportsOpeningDocumentsInPlace</key>
	<true/>

	<key>CFBundleDocumentTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeName</key>
			<string>GGUF Language Model</string>
			<key>CFBundleTypeRole</key>
			<string>Viewer</string>
			<key>LSHandlerRank</key>
			<string>Alternate</string>
			<key>LSItemContentTypes</key>
			<array>
				<string>org.ggml.gguf</string>
			</array>
		</dict>
	</array>

	<key>UTImportedTypeDeclarations</key>
	<array>
		<dict>
			<key>UTTypeIdentifier</key>
			<string>org.ggml.gguf</string>
			<key>UTTypeDescription</key>
			<string>GGUF Language Model</string>
			<key>UTTypeConformsTo</key>
			<array>
				<string>public.data</string>
			</array>
			<key>UTTypeTagSpecification</key>
			<dict>
				<key>public.filename-extension</key>
				<array>
					<string>gguf</string>
				</array>
			</dict>
		</dict>
	</array>
</dict>
</plist>
