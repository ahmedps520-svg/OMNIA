+// OMNIA: a server on Wi-Fi can vanish at any moment (a locked phone, a closed laptop). Instead of
+// aborting the process, a lost connection marks its endpoint failed, every later command on it
+// completes at once with harmless defaults, and the app asks ggml_backend_rpc_failed_endpoints()
+// after each step whether the work it just did can be trusted.
+static std::mutex               rpc_failed_mutex;
+static std::vector<std::string> rpc_failed_list;
+
+static void rpc_mark_failed(const std::string & endpoint) {
+    std::lock_guard<std::mutex> lock(rpc_failed_mutex);
+    if (std::find(rpc_failed_list.begin(), rpc_failed_list.end(), endpoint) == rpc_failed_list.end()) {
+        rpc_failed_list.push_back(endpoint);
+    }
+}
+
+// Writes the failed endpoints, comma-separated, into buffer (when given) and returns how many there are.
+static size_t ggml_backend_rpc_failed_endpoints(char * buffer, size_t size) {
+    std::lock_guard<std::mutex> lock(rpc_failed_mutex);
+    if (buffer != nullptr && size > 0) {
+        std::string joined;
+        for (const auto & endpoint : rpc_failed_list) {
+            if (!joined.empty()) {
+                joined += ",";
+            }
+            joined += endpoint;
+        }
+        snprintf(buffer, size, "%s", joined.c_str());
+    }
+    return rpc_failed_list.size();
+}
+
+static void ggml_backend_rpc_clear_failures(void) {
+    std::lock_guard<std::mutex> lock(rpc_failed_mutex);
+    rpc_failed_list.clear();
+}
