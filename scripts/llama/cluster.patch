+// OMNIA: writing to a connection the other side dropped returns an error instead of raising
+// SIGPIPE, whose default action ends the whole app.
+static void set_no_sigpipe(sockfd_t sockfd) {
+#ifdef SO_NOSIGPIPE
+    int flag = 1;
+    setsockopt(sockfd, SOL_SOCKET, SO_NOSIGPIPE, (char *)&flag, sizeof(int));
+#else
+    (void) sockfd;
+#endif
+}
+
+#ifndef _WIN32
+static void set_io_timeout(sockfd_t sockfd, int seconds) {
+    struct timeval timeout = {};
+    timeout.tv_sec = seconds;
+    setsockopt(sockfd, SOL_SOCKET, SO_RCVTIMEO, &timeout, sizeof(timeout));
+    setsockopt(sockfd, SOL_SOCKET, SO_SNDTIMEO, &timeout, sizeof(timeout));
+}
+
+// connect() that gives up after timeout_ms instead of the system's minute or more
+static bool connect_with_timeout(sockfd_t sockfd, const struct sockaddr * addr, socklen_t addr_len, int timeout_ms) {
+    const int flags = fcntl(sockfd, F_GETFL, 0);
+    if (flags < 0 || fcntl(sockfd, F_SETFL, flags | O_NONBLOCK) < 0) {
+        return ::connect(sockfd, addr, addr_len) == 0;
+    }
+    int ret = ::connect(sockfd, addr, addr_len);
+    if (ret < 0 && errno == EINPROGRESS) {
+        struct pollfd pfd = {};
+        pfd.fd = sockfd;
+        pfd.events = POLLOUT;
+        ret = -1;
+        if (poll(&pfd, 1, timeout_ms) == 1) {
+            int error = 0;
+            socklen_t error_len = sizeof(error);
+            if (getsockopt(sockfd, SOL_SOCKET, SO_ERROR, &error, &error_len) == 0 && error == 0) {
+                ret = 0;
+            }
+        }
+    }
+    fcntl(sockfd, F_SETFL, flags);
+    return ret == 0;
+}
+#endif
